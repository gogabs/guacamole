{
  "name": "guacamole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:front",
    "dev:front": "bun --bun ./node_modules/vite/bin/vite.js dev --host 127.0.0.1",
    "dev:server": "deno task dev",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "check": "bun --bun ./node_modules/@sveltejs/kit/svelte-kit.js sync && bun --bun ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "preview": "deno task start"
  },
  "dependencies": {
    "lucide-svelte": "^0.468.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "fdir": "^6.5.0",
    "postcss": "^8.4.49",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "6.0.6"
  }
}
