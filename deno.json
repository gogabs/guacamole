{
  "tasks": {
    "dev": "deno run --watch=server,core --allow-env=PORT,HOST --allow-net --allow-read=. --allow-write=data server/main.ts",
    "start": "deno run --allow-env=PORT,HOST --allow-net --allow-read=. --allow-write=data server/main.ts",
    "check": "deno check server/*.ts core/*.ts core/sheet/*.ts core/sheet/templates/*.ts",
    "test": "deno test --allow-net=127.0.0.1 --allow-read --allow-write core/ server/"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
